# Node & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Security & JWT
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-token-key-replace-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monolith_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monolith_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
