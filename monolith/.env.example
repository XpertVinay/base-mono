# Node & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Security & JWT
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-token-key-replace-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PII_ENCRYPTION_KEY=pii-encryption-key-for-tenant-rest-and-flight-min32chars

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monolith_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monolith_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Notification Configuration (Adapter-based & DRY-Run)
NOTIFICATION_DRY_RUN=true
NOTIFICATION_EMAIL_PROVIDER=SENDGRID
NOTIFICATION_SMS_PROVIDER=TWILIO
NOTIFICATION_WHATSAPP_PROVIDER=META_CLOUD
NOTIFICATION_PUSH_PROVIDER=FCM

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@monolith.local
SENDGRID_FROM_NAME=Monolith Platform

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

# Meta Cloud (WhatsApp Cloud API)
META_WHATSAPP_PHONE_NUMBER_ID=100000000000001
META_WHATSAPP_ACCESS_TOKEN=EAAG_your_meta_access_token_here
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v21.0

# Firebase Cloud Messaging (FCM Push)
FCM_PROJECT_ID=monolith-push-dev
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_BEARER_TOKEN=
