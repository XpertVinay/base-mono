# Environment Configuration
VITE_APP_ENV=development

# API Configuration (Enterprise Microservices Unified API & gRPC Gateway on :4000)
# BaseUrl = VITE_GATEWAY_URL + VITE_API_BASE_URL + (VITE_<SERVICE>_ENDPOINT | Config.ENDPOINTS[service])
VITE_API_BASE_URL=/api/v1
VITE_GATEWAY_URL=http://localhost:4000
VITE_IAM_ENDPOINT=/iam
VITE_AUDIT_ENDPOINT=/audit
VITE_TENANTS_ENDPOINT=/tenants
VITE_GRAFANA_URL=http://localhost:3000
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_TRUSTED_API_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:3000

# Multi-Tenant Resolution Strategy: 'subdomain' | 'custom_domain' | 'path' | 'dev_override'
VITE_TENANT_RESOLUTION_STRATEGY=dev_override

# Development Default Tenant
VITE_DEFAULT_TENANT=apex-health

# Mock API toggle (set to true to run offline without backend-ms gateway)
VITE_ENABLE_MOCK_API=false
