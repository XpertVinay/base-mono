# Environment Configuration
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TRUSTED_API_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://api.devlupsoft.com

# Multi-Tenant Resolution Strategy: 'subdomain' | 'custom_domain' | 'path' | 'dev_override'
VITE_TENANT_RESOLUTION_STRATEGY=dev_override

# Development Default Tenant
VITE_DEFAULT_TENANT=apex-health

# Mock API toggle (set to true to run fully offline without backend services)
VITE_ENABLE_MOCK_API=true
