.env
.env.*
!.env.example
*.pem
*.key
*.pub.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.vault_pass
secrets.yaml
secrets.json
**/secrets.json
vault-password.txt
**/app-secrets.yaml

# ------------------------------------------------------------------------------
# Build & Compiled Outputs
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.parcel-cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
