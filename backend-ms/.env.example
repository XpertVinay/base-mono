# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microservices_db
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security
JWT_SECRET=dev-jwt-super-secret-key-for-iam-service-32-chars
INTERNAL_SERVICE_SECRET=dev-internal-service-secret-token-32-chars
OIDC_ENCRYPTION_KEY=dev-oidc-encryption-secret-key-32-chars
CORS_ORIGIN=*

# Configurable Multi-Tenancy
MULTI_TENANCY_ENABLED=true
MULTI_TENANCY_MODE=optional
DEFAULT_TENANT_ID=default
TENANT_HEADER=x-tenant-id
TENANT_SLUG_HEADER=x-tenant-slug
TENANT_SUBDOMAIN_ENABLED=false

# Service Ports & gRPC Upstreams
GATEWAY_PORT=4000
GRPC_REQUEST_TIMEOUT_MS=15000
VERIFY_TOKEN_VIA_GRPC=false

IAM_PORT=4001
IAM_GRPC_PORT=50051
IAM_GRPC_URL=localhost:50051

ASSET_PORT=4002
ASSET_GRPC_PORT=50052
ASSET_GRPC_URL=localhost:50052

CONFIG_PORT=4003
CONFIG_GRPC_PORT=50053
CONFIG_GRPC_URL=localhost:50053

NOTIFICATION_PORT=4004
NOTIFICATION_GRPC_PORT=50054
NOTIFICATION_GRPC_URL=localhost:50054

SCHEDULER_PORT=4005
SCHEDULER_GRPC_PORT=50055
SCHEDULER_GRPC_URL=localhost:50055

ORDER_PORT=4006
ORDER_GRPC_PORT=50056
ORDER_GRPC_URL=localhost:50056

TRANSACTION_PORT=4007
TRANSACTION_GRPC_PORT=50057
TRANSACTION_GRPC_URL=localhost:50057

SEARCH_PORT=4008
SEARCH_GRPC_PORT=50058
SEARCH_GRPC_URL=localhost:50058

INVENTORY_PORT=4009
INVENTORY_GRPC_PORT=50059
INVENTORY_GRPC_URL=localhost:50059

AI_PORT=4010
AI_GRPC_PORT=50060
AI_GRPC_URL=localhost:50060
MCP_ENCRYPTION_KEY=dev-mcp-encryption-secret-key-32-chars

AUDIT_PORT=4011
AUDIT_GRPC_PORT=50061
AUDIT_GRPC_URL=localhost:50061
ENABLE_CLOUDWATCH=false
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true
