# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microservices_db
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security
JWT_SECRET=dev-jwt-super-secret-key-for-iam-service-32-chars
INTERNAL_SERVICE_SECRET=dev-internal-service-secret-token-32-chars
CORS_ORIGIN=*

# Service Ports
GATEWAY_PORT=4000
IAM_PORT=4001
IAM_GRPC_PORT=50051
ASSET_PORT=4002
CONFIG_PORT=4003
CONFIG_GRPC_PORT=50053
NOTIFICATION_PORT=4004
SCHEDULER_PORT=4005
ORDER_PORT=4006
TRANSACTION_PORT=4007
SEARCH_PORT=4008
INVENTORY_PORT=4009
INVENTORY_GRPC_PORT=50059
AUDIT_PORT=4011
AUDIT_GRPC_PORT=50061
ENABLE_CLOUDWATCH=false
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true
