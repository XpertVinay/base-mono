NODE_ENV=development
PORT=4010
GRPC_PORT=50060
SERVICE_NAME=ai-service

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microservices_db
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Sibling Microservices (gRPC & HTTP)
NOTIFICATION_GRPC_URL=localhost:50054
SEARCH_GRPC_URL=localhost:50058
CONFIG_GRPC_URL=localhost:50053

# Security & Multi-Tenancy
JWT_SECRET=dev-jwt-super-secret-key-for-iam-service-32-chars
INTERNAL_SERVICE_SECRET=dev-internal-service-secret-token-32-chars
MCP_ENCRYPTION_KEY=dev-mcp-encryption-secret-key-32-chars
MULTI_TENANCY_ENABLED=true
MULTI_TENANCY_MODE=optional
DEFAULT_TENANT_ID=default
CORS_ORIGIN=*

# MCP Client & Guardrails
MCP_REQUEST_TIMEOUT_MS=15000
MCP_ALLOW_STDIO=true
MCP_STDIO_ALLOWED_COMMANDS=node,npx,uvx,python,python3
MCP_INTERNAL_DB_ALLOWED_SCHEMAS=iam,orders,inventory,transactions,search,notification,asset,audit,app_config,scheduler,ai
MCP_BLOCK_PRIVATE_IPS=false
AI_IN_MEMORY_STORE=false

