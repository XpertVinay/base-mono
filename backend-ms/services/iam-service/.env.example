NODE_ENV=development
PORT=4001
HOST=0.0.0.0
GRPC_PORT=50051
SERVICE_NAME=iam-service
JWT_SECRET=dev-jwt-super-secret-key-for-iam-service-32-chars
JWT_EXPIRES_IN=3600
INTERNAL_SERVICE_SECRET=dev-internal-service-secret-token-32-chars
OIDC_ENCRYPTION_KEY=dev-oidc-encryption-secret-key-32-chars
OIDC_STATE_TTL_MS=600000
MULTI_TENANCY_ENABLED=true
MULTI_TENANCY_MODE=optional
DEFAULT_TENANT_ID=default
TENANT_HEADER=x-tenant-id
TENANT_SLUG_HEADER=x-tenant-slug
TENANT_SUBDOMAIN_ENABLED=false
DB_HOST=postgres
DB_PORT=5432
DB_NAME=microservices_db
DB_USER=postgres
DB_PASSWORD=postgres
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
CORS_ORIGIN=*
