NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SERVICE_NAME=api-gateway
JWT_SECRET=dev-jwt-super-secret-key-for-iam-service-32-chars
INTERNAL_SERVICE_SECRET=dev-internal-service-secret-token-32-chars
MULTI_TENANCY_ENABLED=true
MULTI_TENANCY_MODE=optional
DEFAULT_TENANT_ID=default
TENANT_HEADER=x-tenant-id
TENANT_SLUG_HEADER=x-tenant-slug
TENANT_SUBDOMAIN_ENABLED=false
CORS_ORIGIN=*

# Downstream Microservices HTTP URLs
IAM_SERVICE_URL=http://iam-service:4001
ASSET_SERVICE_URL=http://asset-service:4002
CONFIG_SERVICE_URL=http://config-service:4003
NOTIFICATION_SERVICE_URL=http://notification-service:4004
SCHEDULER_SERVICE_URL=http://scheduler-service:4005
ORDER_SERVICE_URL=http://order-service:4006
TRANSACTION_SERVICE_URL=http://transaction-service:4007
SEARCH_SERVICE_URL=http://search-service:4008
INVENTORY_SERVICE_URL=http://inventory-service:4009
AUDIT_SERVICE_URL=http://audit-service:4011

# Downstream Microservices gRPC URLs
IAM_GRPC_URL=localhost:50051
ASSET_GRPC_URL=localhost:50052
CONFIG_GRPC_URL=localhost:50053
NOTIFICATION_GRPC_URL=localhost:50054
SCHEDULER_GRPC_URL=localhost:50055
ORDER_GRPC_URL=localhost:50056
TRANSACTION_GRPC_URL=localhost:50057
SEARCH_GRPC_URL=localhost:50058
INVENTORY_GRPC_URL=localhost:50059
AUDIT_GRPC_URL=localhost:50061
RBAC_GRPC_URL=localhost:50063
