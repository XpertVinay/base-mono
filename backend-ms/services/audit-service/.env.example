NODE_ENV=development
PORT=4011
HOST=0.0.0.0
GRPC_PORT=50061
SERVICE_NAME=audit-service

# Database & Messaging
DB_HOST=postgres
DB_PORT=5432
DB_NAME=microservices_db
DB_USER=postgres
DB_PASSWORD=postgres
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
CORS_ORIGIN=*

# Flag-based Monitoring & Logging Configuration
ENABLE_CLOUDWATCH=false
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true

# AWS CloudWatch Adapter Configuration (Used when ENABLE_CLOUDWATCH=true)
AWS_REGION=us-east-1
AWS_CLOUDWATCH_LOG_GROUP=/platform/microservices/audit
AWS_CLOUDWATCH_LOG_STREAM=audit-stream
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
