# ==============================================================================
# INFRASTRUCTURE PLATFORM: ENVIRONMENT CONFIGURATION TEMPLATE
# Purpose:
#   Provides environment variables required for Terraform, Ansible, and scripts.
# Instructions:
#   Copy this file to '.env' and populate with your credentials and parameters.
# Security:
#   NEVER commit the populated '.env' file to version control.
# ==============================================================================

# Target Infrastructure Provider (Options: 'aws', 'gcp', 'azure', 'digitalocean', 'vps', 'local')
INFRA_PROVIDER=aws

# Target Environment (Options: 'dev', 'staging', 'prod', 'local')
ENVIRONMENT=dev

# Deployment Mode (Options: 'docker', 'k8s-self-managed', 'k8s-managed')
DEPLOYMENT_MODE=docker

# Application Server Capacity (Allowed: 1 to 5 for Cloud; Strictly 1 for Generic VPS)
APPLICATION_SERVER_COUNT=1

# AWS Credentials and Region (Used if INFRA_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# GCP Credentials and Region (Used if INFRA_PROVIDER=gcp)
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Credentials and Location (Used if INFRA_PROVIDER=azure)
ARM_SUBSCRIPTION_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
AZURE_LOCATION=eastus

# DigitalOcean Credentials and Region (Used if INFRA_PROVIDER=digitalocean)
DIGITALOCEAN_TOKEN=
DO_REGION=nyc3

# Generic VPS Parameters (Used if INFRA_PROVIDER=vps, e.g., Hostinger, Contabo, OVH)
VPS_IPV4=127.0.0.1
VPS_HOSTNAME=vps-app-1
VPS_SSH_USER=root
VPS_DOMAIN=

# SSH Key Configuration for Host Access
SSH_KEY_NAME=infra-platform-key
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# Ansible Vault Password File (Optional but recommended for secrets)
ANSIBLE_VAULT_PASSWORD_FILE=~/.vault_pass

# Remote State Backend (S3 Bucket / GCS Bucket)
TF_STATE_BUCKET=
TF_STATE_LOCK_TABLE=

# Application Container Details
APP_IMAGE=ghcr.io/org/sample-app:latest
APP_PORT=8080
HOST_PORT=80
