# ==============================================================================
# INFRASTRUCTURE PLATFORM: GIT IGNORE SPECIFICATION
# Purpose:
#   Prevents state files, secrets, machine-generated artifacts, and credentials
#   from ever entering version control.
# ==============================================================================

# Local Environment Variables & Secrets (Designated folders & root)
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.pub.key
*.id_rsa
*.vault_pass
secrets.yaml
secrets.json
**/secrets.json
vault-password.txt
**/app-secrets.yaml

# Terraform State and Local Directories
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
**/terraform.tfvars.json
!example.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible Artifacts and Cache
.ansible/
*.retry
ansible-inventory-generated.ini
ansible-inventory-generated.yaml
facts_cache/

# Kubernetes & Helm
kubeconfig*
*.kubeconfig
*.tgz

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Testing & Logs
test-output/
*.log
coverage/
.pytest_cache/
