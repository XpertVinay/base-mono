# ==============================================================================
# ENVIRONMENT TEMPLATE: PRODUCTION (.env.example)
# Designated Folder: infra/environments/prod/
# NOTE: In production, secrets SHOULD NOT be stored in .env files on disk.
# Prefer CI/CD pipeline secrets or Cloud Provider Secret Managers (AWS Secrets Manager).
# This file serves as an emergency break-glass template only.
# ==============================================================================

ENVIRONMENT=prod
INFRA_PROVIDER=aws
APPLICATION_SERVER_COUNT=3
AWS_REGION=us-east-1
DEPLOYMENT_MODE=k8s-managed

APP_IMAGE=ghcr.io/org/sample-app:v1.0.0
APP_PORT=8080
HOST_PORT=80
LOG_LEVEL=warn
NODE_ENV=production

# Admin CIDR for SSH (Must NOT be 0.0.0.0/0)
ADMIN_CIDR_BLOCKS='["10.0.0.0/8"]'

SSH_KEY_NAME=infra-prod-key
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

DATABASE_URL=postgresql://prod_admin:SECURE_PASSWORD@prod-db.internal:5432/platform_prod
API_SECRET_KEY=prod-ultra-secure-key-99999
