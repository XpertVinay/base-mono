# ==============================================================================
# ENVIRONMENT TEMPLATE: DEV (.env.example)
# Designated Folder: infra/environments/dev/
# Instructions:
#   Copy this file to '.env' in this directory for local developer overrides.
#   NOTE: .env is COMPLETELY OPTIONAL. If absent, dynamic resolution will use
#   CI/CD secrets, Cloud Provider Secret Managers, or defaults.
# ==============================================================================

# Core Parameters
ENVIRONMENT=dev
INFRA_PROVIDER=aws
APPLICATION_SERVER_COUNT=1
AWS_REGION=us-east-1
DEPLOYMENT_MODE=docker

# Application Configuration
APP_IMAGE=ghcr.io/org/sample-app:latest
APP_PORT=8080
HOST_PORT=80
LOG_LEVEL=debug
NODE_ENV=development

# Credentials (Optional if using AWS CLI / SSO / OIDC / Secret Manager)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# SSH Key Configuration
SSH_KEY_NAME=infra-dev-key
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# Application Secrets (Optional if fetched from AWS Secrets Manager)
DATABASE_URL=postgresql://dev_user:dev_pass@localhost:5432/platform_dev
API_SECRET_KEY=dev-secret-key-12345
