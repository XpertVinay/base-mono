# ==============================================================================
# ENVIRONMENT TEMPLATE: LOCAL (.env.example)
# Designated Folder: infra/environments/local/
# ==============================================================================

ENVIRONMENT=local
INFRA_PROVIDER=local
APPLICATION_SERVER_COUNT=1
DEPLOYMENT_MODE=docker

# Local Kubernetes Parameters (Used when DEPLOYMENT_MODE is k8s-self-managed / k8s)
K8S_NAMESPACE=local
K8S_NODE_PORT=30080

APP_IMAGE=ghcr.io/org/sample-app:latest
APP_PORT=8888
HOST_PORT=80
LOG_LEVEL=debug
NODE_ENV=local

DATABASE_URL=postgresql://local_user:local_pass@localhost:5432/platform_local
API_SECRET_KEY=local-dev-secret-key-11111
