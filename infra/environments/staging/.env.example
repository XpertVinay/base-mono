# ==============================================================================
# ENVIRONMENT TEMPLATE: STAGING (.env.example)
# Designated Folder: infra/environments/staging/
# ==============================================================================

ENVIRONMENT=staging
INFRA_PROVIDER=aws
APPLICATION_SERVER_COUNT=2
AWS_REGION=us-east-1
DEPLOYMENT_MODE=k8s-self-managed

APP_IMAGE=ghcr.io/org/sample-app:rc-latest
APP_PORT=8080
HOST_PORT=80
LOG_LEVEL=info
NODE_ENV=staging

SSH_KEY_NAME=infra-staging-key
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

DATABASE_URL=postgresql://staging_user:staging_pass@staging-db.internal:5432/platform_staging
API_SECRET_KEY=staging-secret-key-67890
