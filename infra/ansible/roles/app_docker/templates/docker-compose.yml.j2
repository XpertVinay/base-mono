# ==============================================================================
# DOCKER COMPOSE RUNTIME TEMPLATE (LANGUAGE-AGNOSTIC)
# ==============================================================================
version: "3.8"

services:
  application:
    image: "{{ app_image }}"
    container_name: "{{ app_name }}"
    restart: unless-stopped
    user: "{{ app_user | default('10001:10001') }}"
    ports:
      - "{{ host_port }}:{{ container_port }}"
    env_file:
      - .env
    environment:
      NODE_ENV: "{{ environment }}"
      PORT: "{{ container_port }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ container_port }}{{ health_path | default('/health') }}"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          cpus: "{{ cpu_limit | default('1.0') }}"
          memory: "{{ memory_limit | default('1G') }}"
